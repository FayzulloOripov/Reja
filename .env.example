# ---------- App
NEXT_PUBLIC_APP_NAME=Reja
# Public URL of the deployment (used in emails, invite links, Telegram deep links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local UI demo without Supabase (never enable in production)
NEXT_PUBLIC_DEMO_MODE=false

# ---------- Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS — used by the scheduler, Telegram bot, ICS feed, share pages
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Scheduler (pg_cron → /api/cron/reminders). Any long random string (openssl rand -hex 32)
CRON_SECRET=

# ---------- Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ---------- Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Reja <reja@yourdomain.uz>

# ---------- Optional
NEXT_PUBLIC_SENTRY_DSN=
ALLOW_DEMO_SEED=false
