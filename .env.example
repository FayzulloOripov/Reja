# Reja — environment variables. Copy to .env.local (local) and to Vercel → Project → Settings →
# Environment Variables (production). NEXT_PUBLIC_* values are sent to the browser; everything else
# stays on the server. Never commit .env.local.

# ---------- App
NEXT_PUBLIC_APP_NAME=Reja
# Public URL of the deployment (invite links, emails, push links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Run the whole app as an in-browser demo (local development and tests only; never in production).
# Without it the real backend is used and the demo is still available at /demo.
NEXT_PUBLIC_DEMO=

# ---------- Supabase (Dashboard → Project Settings → API Keys / Data API)
# The project URL only, without /rest/v1 — e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" key (sb_publishable_…). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_…). Server only: bypasses RLS (scheduler, ICS feed, share pages, e2e setup).
SUPABASE_SECRET_KEY=
# Postgres connection string, used only to run migrations from this machine
# (Dashboard → Connect → Session pooler). Contains the database password.
SUPABASE_DB_URL=

# ---------- Scheduler (pg_cron → /api/cron/reminders). Any long random string: openssl rand -hex 32
CRON_SECRET=

# ---------- Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Email (Resend) — optional until a domain is verified; email is skipped while empty
RESEND_API_KEY=
EMAIL_FROM=Reja <reja@yourdomain.uz>

# ---------- Telegram — postponed. Leave empty: every Telegram feature stays hidden ("Tez orada").
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ---------- Google Calendar (two-way) — optional; the Settings card says «Tez orada» while empty
# Google Cloud Console → APIs & Services: enable "Google Calendar API", create an OAuth client
# (type: Web application) with the redirect URI  <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Optional
NEXT_PUBLIC_SENTRY_DSN=
# Lets `npm run seed:demo` write sample data into a real project (tests only, never production)
ALLOW_DEMO_SEED=false

# ---------- Playwright against the real backend (.env.test.local is read first)
# E2E_BASE_URL=http://localhost:3100
